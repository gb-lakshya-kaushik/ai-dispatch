# Vertex AI API Key for Gemini explanations (optional - fallback works without it)
VERTEX_AI_API_KEY=

# Vertex AI project/location (optional, only needed for project-scoped access)
# VERTEX_AI_PROJECT=
# VERTEX_AI_LOCATION=us-central1

# Database (defaults to SQLite in backend/data/dispatch.db)
# DATABASE_URL=sqlite:///./data/dispatch.db
